NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_URL=http://127.0.0.1:4173
DATABASE_URL=postgres://netra:netra@127.0.0.1:5432/netra_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional in local development: writes verification/reset links to the server log.
# Production requires a real email sender implementation and verified sender domain.
EMAIL_MODE=console
# For EMAIL_MODE=smtp (required in production):
# EMAIL_FROM=NETRA <no-reply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Local development stores completed media on disk. Production requires S3-compatible object storage.
MEDIA_STORAGE_MODE=local
MEDIA_STORAGE_ROOT=./data/media
MEDIA_MAX_BYTES=524288000
# Optional comma-separated account IDs for private test-library access in production.
NETRA_ADMIN_USER_IDS=
# Required when MEDIA_STORAGE_MODE=s3:
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=netra-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.example.com/netra-media
# S3_FORCE_PATH_STYLE=false
